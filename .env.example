# Local pipeline
FIRMS_MAP_KEY=your-nasa-firms-map-key        # https://firms.modaps.eosdis.nasa.gov/api/  (local only; in AWS it lives in SSM)
# AWS
AWS_REGION=ap-south-1
FIRMS_MAP_KEY_PARAM=/smoulder/firms_map_key   # SSM SecureString created by `python scripts/tasks.py deploy`
BEDROCK_MODEL_ID=apac.anthropic.claude-sonnet-4-20250514-v1:0
LOCATION_PLACE_INDEX=geo-places (Places API v2, no index resource needed)
BUDGET_EMAIL=you@example.com
# Web (set by the deploy script for live mode)
VITE_DATA_MODE=offline                        # offline | live
VITE_API_BASE_URL=
